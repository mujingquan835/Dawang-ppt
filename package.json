{
  "name": "dawang-ppt",
  "version": "0.2.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/fusion/*.test.mjs tests/fusion/*.spec.mjs",
    "build": "node skills/dawang-ppt/scripts/dawang.mjs build",
    "preview": "node skills/dawang-ppt/scripts/dawang.mjs preview:start",
    "export:pptx": "node skills/dawang-ppt/scripts/dawang.mjs export:pptx",
    "qa": "node skills/dawang-ppt/scripts/dawang.mjs qa:project",
    "examples": "node examples/matrix.mjs",
    "test:fusion": "node --test tests/fusion/*.test.mjs tests/fusion/*.spec.mjs",
    "historical:build": "node runtime/cli.mjs build",
    "export:pdf": "node skills/dawang-ppt/scripts/dawang.mjs export:pdf"
  },
  "dependencies": {
    "pptxgenjs": "4.0.1",
    "playwright-core": "1.60.0",
    "pngjs": "7.0.0",
    "jszip": "3.10.1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "image-size": "2.0.3"
  }
}
